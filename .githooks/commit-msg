#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits. See CONTRIBUTING.md.
# Enable with: git config core.hooksPath .githooks
msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Commits git creates on its own, and fixup/squash markers, are not user-authored summaries.
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

if printf '%s' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9._/-]+\))?: .+'; then
  exit 0
fi

echo "commit-msg: first line must be Conventional Commits, e.g. 'fix(startup): ...'." >&2
echo "            allowed types: feat fix docs style refactor perf test build ci chore revert" >&2
echo "            got: $first_line" >&2
exit 1
